<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Show Name Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/showNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter show name"
            android:layout_marginBottom="24dp" />

        <!-- File Selection Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audio Files"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/selectFilesBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select MP3 Files"
            android:layout_marginBottom="16dp"
            android:backgroundTint="?attr/colorPrimary" />

        <!-- Selected Files List -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected Files:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/selectedFilesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:background="@android:color/darker_gray"
            android:padding="8dp"
            android:minHeight="100dp">

            <TextView
                android:id="@+id/noFilesMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No files selected"
                android:textAlignment="center"
                android:textStyle="italic"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- Events Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Events"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/addEventBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Event"
            android:layout_marginBottom="16dp"
            android:backgroundTint="?attr/colorAccent" />

        <!-- Events List -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Events:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/eventsListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:background="@android:color/darker_gray"
            android:padding="8dp"
            android:minHeight="100dp">

            <TextView
                android:id="@+id/noEventsMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No events added"
                android:textAlignment="center"
                android:textStyle="italic"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveShowBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Show"
                android:layout_marginEnd="8dp"
                android:backgroundTint="?attr/colorPrimary" />

            <Button
                android:id="@+id/clearShowBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear"
                android:backgroundTint="@android:color/holo_red_dark" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
